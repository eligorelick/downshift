root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,csproj,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# The app targets .NET Framework 4.7.2 and is written in C# 7.3.
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
