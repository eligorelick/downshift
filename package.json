{
  "name": "downshift",
  "private": true,
  "version": "0.2.0",
  "description": "Focus blocks, rest timers and guided breathing, with optional live heart rate from a Bluetooth heart rate monitor.",
  "author": "Eli Gorelick",
  "license": "MIT",
  "homepage": "https://eligorelick.github.io/downshift/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eligorelick/downshift.git"
  },
  "bugs": {
    "url": "https://github.com/eligorelick/downshift/issues"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build",
    "test": "bun test packages/core packages/ble packages/app/test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "bun run --cwd packages/app e2e",
    "desktop": "bun run --cwd packages/desktop start",
    "desktop:dist": "bun run --cwd packages/desktop dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3",
    "@types/bun": "^1.1.13"
  }
}
