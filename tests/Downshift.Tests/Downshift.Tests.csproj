<Project Sdk="Microsoft.NET.Sdk">
  <!-- A plain console program: it runs every check, prints one line per check, and exits non-zero on failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core.cs has no Windows dependencies, so the logic is tested on any OS. -->
    <Compile Include="../../src/Downshift/Core.cs" />
  </ItemGroup>
</Project>
